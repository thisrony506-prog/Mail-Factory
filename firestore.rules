rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['gmrony135@gmail.com', 'mailfactorybd@gmail.com', 'iamronyofficial1@gmail.com']
      );
    }
    
    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    match /reviews/{userId} {
      allow get: if isAdmin() || resource.data.status == 'approved' || isOwner(userId);
      allow list: if isAdmin() || resource.data.status == 'approved';
      
      allow create: if isOwner(userId) 
                    && request.resource.data.userId == userId 
                    && request.resource.data.status == 'pending' 
                    && request.resource.data.rating is int 
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
                    
      allow update: if isAdmin() || (
        isOwner(userId) 
        && request.resource.data.userId == userId 
        && request.resource.data.status == 'pending' 
        && request.resource.data.rating is int 
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
      );
      
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
